{
  "schemaVersion": "sdp-vnext-pilot-negative-mutation-v0",
  "experimental": true,
  "case": "github-issue-trailing-slash-is-not-canonical",
  "sourceExample": "simple-single-domain.json",
  "mutations": [
    {"op": "replace", "path": "/registries/0/domains/0/issuedIds/0/allocationIssue", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/registries/0/domains/0/issuedIds/1/allocationIssue", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/records/0/issueAuthorities/0", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/records/1/assignmentIssue", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/assignments/0/authority/issue", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/assignments/0/coordination/mergeOrder/0", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/reservationSets/0/assignments/0/issue", "value": "https://github.com/example/tiny-app/issues/10/"},
    {"op": "replace", "path": "/reservationSets/0/mergeOrder/0", "value": "https://github.com/example/tiny-app/issues/10/"}
  ],
  "rebindReservationDigests": true,
  "expectedErrors": ["INVALID_GITHUB_ISSUE", "INVALID_INVENTORY_AUTHORITY", "REPOSITORY_AUTHORITY_MISMATCH"]
}
