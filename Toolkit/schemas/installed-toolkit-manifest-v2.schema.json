{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp.local/schemas/installed-toolkit-manifest-v2.schema.json",
  "title": "Installed SDP Toolkit Facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolkitVersion",
    "frameworkVersion",
    "agentsContractVersion",
    "installerVersion",
    "toolkitInstalledAt",
    "sourceCommit",
    "skills",
    "capabilities",
    "processProfile",
    "managementProfile",
    "configurationDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "toolkitVersion": {
      "$ref": "#/$defs/semver"
    },
    "frameworkVersion": {
      "$ref": "#/$defs/semver"
    },
    "agentsContractVersion": {
      "$ref": "#/$defs/semver"
    },
    "installerVersion": {
      "$ref": "#/$defs/semver"
    },
    "toolkitInstalledAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/semver"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "processProfile": {
      "const": "sdp-five-phase/0.1"
    },
    "managementProfile": {
      "const": "sdp-project-management/0.1"
    },
    "configurationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
