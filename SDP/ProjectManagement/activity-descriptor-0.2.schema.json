{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity descriptor 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "projectId",
    "title",
    "owner",
    "mandate",
    "sourceCards",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "sdp-activity/0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^ACTIVITY-[A-Z][A-Z0-9]*-[0-9]{4,}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "sourceCards": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^KB-[A-Z][A-Z0-9]*-[0-9]{3,}$"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "id",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          },
          "membership": {
            "enum": [
              "contribution",
              "whole-scope"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "availability": {
            "const": "unavailable"
          },
          "unavailableReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "availability"
              ]
            },
            "then": {
              "required": [
                "projectId",
                "unavailableReason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "unavailableReason"
                ]
              }
            }
          }
        ]
      }
    },
    "systems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activityId"
        ],
        "properties": {
          "activityId": {
            "type": "string",
            "pattern": "^ACTIVITY-[A-Z][A-Z0-9]*-[0-9]{4,}$"
          },
          "satisfiedByEventId": {
            "type": "string",
            "pattern": "^EVT-ACTIVITY-[A-Z][A-Z0-9]*-(?:[0-9]{6,}|[A-F0-9]{32}(?:-TARGET)?)$"
          }
        }
      }
    }
  }
}
