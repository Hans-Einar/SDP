{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity admission adoption payload 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "operationId",
    "requestDigest",
    "authority",
    "stores"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source"
      ],
      "properties": {
        "role": {
          "const": "project-owner"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statePath"
        ],
        "properties": {
          "statePath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
