{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Activity descriptor 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "projectId",
    "title",
    "owner",
    "mandate",
    "sourceCards",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "sdp-activity/0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^ACTIVITY-[A-Z][A-Z0-9]*-[0-9]{4,}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "sourceCards": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^KB-[A-Z][A-Z0-9]*-[0-9]{3,}$"
      }
    },
    "systems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "id",
          "path"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
