{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combined coordination view and console event contract",
  "description": "Select CoordinationView or CoordinationEvent; resolve references against this file and adjacent canonical schemas.",
  "$defs": {
    "CoordinationItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "work",
            "report",
            "attention",
            "review"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "work": {
          "$ref": "overview.schema.json#/$defs/work"
        },
        "report": {
          "$ref": "inbox.schema.json#/properties/reports/items"
        },
        "attention": {
          "$ref": "schema.json#/$defs/AttentionView"
        },
        "review": {
          "$ref": "#/$defs/ReviewNotice"
        }
      },
      "required": [
        "id",
        "runId",
        "kind",
        "priority"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "work"
            }
          },
          "required": [
            "work"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "report"
                ]
              },
              {
                "required": [
                  "attention"
                ]
              },
              {
                "required": [
                  "review"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "report"
            }
          },
          "required": [
            "report"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "work"
                ]
              },
              {
                "required": [
                  "attention"
                ]
              },
              {
                "required": [
                  "review"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "attention"
            }
          },
          "required": [
            "attention"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "work"
                ]
              },
              {
                "required": [
                  "report"
                ]
              },
              {
                "required": [
                  "review"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "review"
            }
          },
          "required": [
            "review"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "work"
                ]
              },
              {
                "required": [
                  "report"
                ]
              },
              {
                "required": [
                  "attention"
                ]
              }
            ]
          }
        }
      ]
    },
    "CoordinationView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "nextCursor": {
          "type": "string"
        },
        "schema": {
          "enum": [
            "sdp-governance-coordination/1",
            "sdp-governance-coordination/2"
          ]
        },
        "scope": {
          "enum": [
            "registered-work-reports-attention-in-selected-checkout",
            "registered-work-reports-attention-reviews-in-selected-checkout"
          ]
        },
        "inspectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/CoordinationItem"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "projectRef",
        "checkoutId",
        "generation",
        "revision",
        "nextCursor",
        "schema",
        "scope",
        "inspectedAt",
        "items",
        "total"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "schema": {
                "const": "sdp-governance-coordination/1"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "registered-work-reports-attention-in-selected-checkout"
              },
              "items": {
                "items": {
                  "not": {
                    "required": [
                      "review"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "const": "registered-work-reports-attention-reviews-in-selected-checkout"
              }
            }
          }
        }
      ]
    },
    "CoordinationEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-governance-coordination-event/1"
        },
        "kind": {
          "enum": [
            "snapshot",
            "result",
            "error",
            "leader-message"
          ]
        },
        "view": {
          "$ref": "#/$defs/CoordinationView"
        },
        "result": {
          "$ref": "schema.json#/$defs/Result"
        },
        "error": {
          "$ref": "schema.json#/$defs/Error/properties/error"
        },
        "leader": {
          "$ref": "leader.schema.json#/$defs/LeaderResult"
        }
      },
      "required": [
        "schema",
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "snapshot"
            }
          },
          "required": [
            "view"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "leader"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "result"
            }
          },
          "required": [
            "result"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "view"
                ]
              },
              {
                "required": [
                  "error"
                ]
              },
              {
                "required": [
                  "leader"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "error"
            }
          },
          "required": [
            "error"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "view"
                ]
              },
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "leader"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "leader-message"
            }
          },
          "required": [
            "leader"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "view"
                ]
              },
              {
                "required": [
                  "result"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ]
          }
        }
      ]
    },
    "ReviewNotice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "prepared",
            "opening",
            "bound",
            "sending",
            "running",
            "completed",
            "failed",
            "interrupted",
            "superseded"
          ]
        },
        "candidate": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reportId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "verdict": {
          "enum": [
            "",
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 8192
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "applicable": {
          "type": "boolean"
        },
        "qualified": {
          "type": "boolean"
        },
        "contextSeparation": {
          "enum": [
            "not-observed",
            "controller-observed-fresh-thread"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "publicationId": {
          "type": "string"
        },
        "publicationStatus": {
          "enum": [
            "",
            "prepared",
            "applying",
            "published"
          ]
        },
        "publicationApplicable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "state",
        "candidate",
        "reportId",
        "verdict",
        "summary",
        "findingCount",
        "applicable",
        "qualified",
        "contextSeparation",
        "conditions",
        "publicationId",
        "publicationStatus",
        "publicationApplicable"
      ]
    }
  }
}
