{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdp:project-governance:inbox:1-or-2",
  "title": "Local report receipt projection with optional durable acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectRef": {
      "type": "string"
    },
    "checkoutId": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "schema": {
      "enum": [
        "sdp-governance-inbox/1",
        "sdp-governance-inbox/2"
      ]
    },
    "inspectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "report-receipts-in-selected-checkout"
    },
    "consumption": {
      "enum": [
        "not-tracked",
        "acknowledgement-recorded-separately"
      ]
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "inputRevision": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "currentState": {
            "type": "string"
          },
          "reportedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "currentRevision": {
            "type": "integer",
            "minimum": 1
          },
          "coverage": {
            "enum": [
              "known",
              "stale",
              "unavailable"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "card": {
                "type": "string"
              },
              "plan": {
                "type": "string"
              },
              "session": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              },
              "step": {
                "type": "string"
              }
            },
            "required": []
          },
          "acknowledgement": {
            "$ref": "#/$defs/ReportAcknowledgement"
          },
          "acknowledgementId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "runId",
          "inputRevision",
          "outcome",
          "text",
          "currentState",
          "reportedRevision",
          "currentRevision",
          "coverage",
          "conditions",
          "selection"
        ],
        "dependentRequired": {
          "acknowledgement": [
            "acknowledgementId"
          ],
          "acknowledgementId": [
            "acknowledgement"
          ]
        }
      }
    }
  },
  "required": [
    "projectRef",
    "checkoutId",
    "generation",
    "schema",
    "inspectedAt",
    "scope",
    "consumption",
    "reports"
  ],
  "$defs": {
    "ReportAcknowledgementRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reportId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedGeneration": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coordinator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "schema": {
          "const": "sdp-governance-report-acknowledgement/1"
        },
        "reportedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "projectRef",
        "checkoutId",
        "operationId",
        "runId",
        "reportId",
        "inputRevision",
        "expectedGeneration",
        "coordinator",
        "note",
        "schema",
        "reportedRevision",
        "expectedRevision"
      ]
    },
    "ReportAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/ReportAcknowledgementRequest"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request",
        "recordedAt"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "sdp-governance-inbox/1"
          }
        }
      },
      "then": {
        "properties": {
          "consumption": {
            "const": "not-tracked"
          },
          "reports": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "acknowledgement"
                    ]
                  },
                  {
                    "required": [
                      "acknowledgementId"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "consumption": {
            "const": "acknowledgement-recorded-separately"
          }
        }
      }
    }
  ]
}
