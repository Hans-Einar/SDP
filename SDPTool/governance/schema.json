            "host.observe",
            "host.disconnect",
            "host.reconcile",
            "input.prepare",
            "input.claim",
            "input.ack",
            "input.uncertain",
            "input.resolve",
            "host.reattach",
            "activate",
            "attention.request",
            "attention.reply",
            "attention.withdraw"
          ]
        },
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            {
              "const": ""
            }
          ]
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "coverage": {
          "type": "string",
          "enum": [
