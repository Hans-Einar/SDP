          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string"
        },
        "attempts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/OwnerInput"
          }
        },
        "attention": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/AttentionQuestion"
          }
        }
