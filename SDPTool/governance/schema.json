        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "const": "absent"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "coverage": {
          "type": "string",
          "enum": [
            "known",
            "unavailable",
            "conflict"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cardId": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation",
        "projectRef",
        "root",
        "checkoutId",
        "revision",
        "selection",
        "sources",
        "coverage",
        "conditions",
        "cardId",
        "planId",
        "sessionId"
      ]
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
