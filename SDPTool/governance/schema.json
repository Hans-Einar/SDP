        "version": {
          "const": "0.1"
        },
        "steps": {
          "const": [
            "implement",
            "verify",
            "review",
            "record"
          ]
        },
        "completion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "steps",
        "completion"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "const": "context"
        },
        "projectRef": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "checkoutId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
