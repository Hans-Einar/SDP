{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdp:project-governance:0.1",
  "title": "PGI1 local application wire contract",
  "$comment": "Select a $defs entry per operation. Runtime additionally rejects duplicate JSON keys, null, non-integer number tokens for revisions, UTF-8 byte limits, unsafe paths and uncovered or stale work. This is not an app-server or MCP protocol schema.",
  "$defs": {
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": []
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "writablePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 63,
          "uniqueItems": true
        }
      },
      "required": [
        "outcome",
        "writablePaths"
      ]
    },
    "RouteRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "intent": {
          "type": "string",
          "maxLength": 65536
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "routineId": {
          "type": "string"
        },
        "routineVersion": {
          "type": "string"
        },
        "inputRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "const": ""
            }
          ]
        }
      },
      "required": [
        "schema",
        "categories"
      ]
    },
    "StartRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "routineDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "assignment": {
          "$ref": "#/$defs/Assignment"
        }
      },
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "requestId",
        "inputRevision",
        "routineDigest",
        "selection",
        "assignment"
      ]
    },
    "TransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "interrupt",
            "resume",
            "report",
            "fail",
            "retry",
            "scope-change",
            "cancel",
            "complete"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "runId",
        "expectedRevision",
        "inputRevision",
        "action",
        "reason"
      ]
    },
    "Routine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "maintenance"
        },
        "version": {
          "const": "0.1"
        },
        "steps": {
          "const": [
            "implement",
            "verify",
            "review",
            "record"
          ]
        },
        "completion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "steps",
        "completion"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "const": "context"
        },
        "projectRef": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "checkoutId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            {
              "const": ""
            }
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "const": "absent"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "coverage": {
          "type": "string",
          "enum": [
            "known",
            "unavailable",
            "conflict"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cardId": {
          "type": "string"
        },
        "planId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "operation",
        "projectRef",
        "root",
        "checkoutId",
        "revision",
        "selection",
        "sources",
        "coverage",
        "conditions",
        "cardId",
        "planId",
        "sessionId"
      ]
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "const": "route"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "missing",
            "ambiguous",
            "incompatible",
            "unavailable",
            "conflict",
            "no-work",
            "matched"
          ]
        },
        "basis": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "routine": {
          "$ref": "#/$defs/Routine"
        },
        "routineDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "operation",
        "disposition",
        "basis",
        "context",
        "routine",
        "routineDigest"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "ready",
            "running",
            "interrupted",
            "verifying",
            "failed",
            "replan-required",
            "canceled"
          ]
        },
        "step": {
          "const": "implement"
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "assignment": {
          "$ref": "#/$defs/Assignment"
        },
        "routine": {
          "$ref": "#/$defs/Routine"
        },
        "routineDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "requestId",
        "state",
        "step",
        "inputRevision",
        "selection",
        "assignment",
        "routine",
        "routineDigest",
        "reason"
      ]
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "type": "string",
          "enum": [
            "start",
            "read",
            "transition"
          ]
        },
        "projectRef": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            },
            {
              "const": ""
            }
          ]
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "known",
            "stale"
          ]
        }
      },
      "required": [
        "schema",
        "operation",
        "projectRef",
        "checkoutId",
        "operationId",
        "run",
        "coverage"
      ]
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "const": "bind"
        },
        "projectRef": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "schema",
        "operation",
        "projectRef",
        "root",
        "checkoutId"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-project-governance/0.1"
        },
        "operation": {
          "const": "error"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "currentRevision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ]
        }
      },
      "required": [
        "schema",
        "operation",
        "status",
        "error"
      ]
    }
  }
}
