        "basis": {
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "routine": {
          "$ref": "#/$defs/Routine"
        },
        "routineDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
