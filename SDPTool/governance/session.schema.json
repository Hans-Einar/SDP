{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sdp:session-execution:0.1",
  "title": "Bounded Session execution wire contract",
  "description": "Wire structure only. Core additionally validates canonical records, authority, path scopes, DAG and workflow digest. C1 does not activate steps or dispatch agents.",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "const": "session-lifecycle"
        },
        "version": {
          "const": "0.1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^KB-[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "coverage": {
          "enum": [
            "whole",
            "contribution"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "milestone",
        "cards",
        "dependsOn",
        "writablePaths",
        "protectedPaths",
        "review",
        "ownerAcceptance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "writablePaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "protectedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "review": {
          "enum": [
            "independent",
            "not-required"
          ]
        },
        "ownerAcceptance": {
          "enum": [
            "required",
            "not-required"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "session",
        "plan",
        "authority",
        "workflow",
        "steps"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "session": {
          "$ref": "#/$defs/record"
        },
        "plan": {
          "$ref": "#/$defs/record"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    },
    "contextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingPath"
      ],
      "properties": {
        "bindingPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adoptRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "bindingPath",
        "inputRevision",
        "reason"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "checkoutId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "bindingPath": {
          "type": "string",
          "minLength": 1
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "resumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "instanceId",
        "expectedRevision",
        "reason"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "checkoutId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "projectRef",
        "checkoutId",
        "bindingPath",
        "bindingDigest",
        "binding",
        "inputRevision",
        "sources"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "operation": {
          "const": "session-context"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "checkoutId": {
          "type": "string"
        },
        "bindingPath": {
          "type": "string",
          "minLength": 1
        },
        "bindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "inputRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "const": "absent"
                  }
                ]
              }
            }
          },
          "minItems": 7,
          "maxItems": 72
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "operationId",
        "instanceId",
        "revision",
        "registration"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "operation": {
          "enum": [
            "session-adopt",
            "session-resume",
            "session-select"
          ]
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "registration": {
          "enum": [
            "pending",
            "committed"
          ]
        },
        "recordEffects": {
          "enum": [
            "prepared",
            "committed"
          ]
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "instanceId",
        "revision",
        "sessionId",
        "planId",
        "workflow",
        "registration",
        "coverage",
        "conditions",
        "steps",
        "nextActions",
        "hostExecution"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "operation": {
          "const": "session-read"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "planId": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "registration": {
          "enum": [
            "pending",
            "committed"
          ]
        },
        "coverage": {
          "enum": [
            "current",
            "stale-or-unavailable"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stage",
              "holds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "const": "admission"
              },
              "holds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "selected": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1,
          "maxItems": 32
        },
        "nextActions": {
          "type": "array",
          "items": {
            "enum": [
              "session-read",
              "session-resume",
              "session-select"
            ]
          }
        },
        "hostExecution": {
          "const": "not-dispatched"
        },
        "recordEffects": {
          "enum": [
            "prepared",
            "committed"
          ]
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "generation",
        "instances"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "operation": {
          "const": "session-list"
        },
        "generation": {
          "type": "string"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          },
          "maxItems": 32
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "definition",
        "digest"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "operation": {
          "const": "session-definition"
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "steps",
            "completion"
          ],
          "properties": {
            "id": {
              "const": "session-lifecycle"
            },
            "version": {
              "const": "0.1"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "selectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "instanceId",
        "expectedRevision",
        "reason",
        "stepId"
      ],
      "properties": {
        "schema": {
          "const": "sdp-session-execution/0.1"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "checkoutId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "stepId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      }
    }
  }
}
