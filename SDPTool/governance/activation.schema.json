{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved PG implementation activation",
  "$comment": "Creates one ready run, not a host attempt. Immutable retries are historical. Existing controller commands recheck current design at launch/continuation.",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "sdp-governance-activation/1"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "checkoutId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "review": {
          "$ref": "design_check.schema.json#/$defs/Request"
        },
        "reviewRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "decisionOperationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "schema",
        "projectRef",
        "checkoutId",
        "operationId",
        "review",
        "reviewRevision",
        "requestId",
        "decisionOperationId"
      ]
    },
    "Result": {
      "$ref": "schema.json#/$defs/Result"
    }
  }
}
