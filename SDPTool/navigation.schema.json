{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDPTool local navigation registration 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "processProfile",
    "models",
    "sdui"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "processProfile": {
      "const": "sdp-five-phase/0.1"
    },
    "projectManifest": {
      "$ref": "#/$defs/path"
    },
    "implementationPlan": {
      "$ref": "#/$defs/path"
    },
    "kanban": {
      "$ref": "#/$defs/path"
    },
    "models": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "sdui": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "defaultModel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "system",
        "source",
        "profile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
