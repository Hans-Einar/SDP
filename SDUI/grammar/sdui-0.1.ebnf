(* SDUI source profile 0.1 — EBNF, not an SDL grammar.
   { X } = zero or more; [ X ] = optional; | = choice; quotes = terminals.
   A .. Z denotes an inclusive character range; EOF is the lexical end marker.
   Whitespace/comments may occur between tokens. EOF is mandatory.
   See language.md for lexical rules and additional semantic constraints. *)
document       = "sdui", "0.1", ";", { module-ref }, definition,
                 { definition }, { connection }, EOF ;
module-ref     = "ref", ":", identifier, string, ";" ;
definition     = identifier, "=", "{", named-box, "}", ";" ;
named-box      = identifier, "=", box ;
box            = "[", [ box-items ], "]" ;
box-items      = property, { ",", property }, [ ",", body-items ] | body-items ;
property       = identifier, "=", literal ;
body-items     = box-child, { ",", box-child }
               | { box-child, "," }, content, { ",", box-child } ;
box-child      = named-box | box ;
content        = "{", row, { ";", row }, [ ";" ], "}" ;
row            = widget, { ",", widget } ;
widget         = identifier, "=", identifier, "(", [ arguments ], ")" ;
arguments      = argument, { ",", argument } ;
argument       = [ identifier, "=" ], value ;
value          = literal | member-ref ;
member-ref     = identifier, ".", identifier, ".", "@", identifier ;
connection     = identifier, ".", identifier, ".", "setHandle", "(",
                 identifier, ".", identifier, ")", ";" ;
literal        = string | number | "true" | "false" | "null" ;
identifier     = letter-or-underscore, { letter-or-underscore | digit } ;
number         = [ "-" ], ( "0" | nonzero-digit, { digit } ),
                 [ ".", digit, { digit } ],
                 [ ( "e" | "E" ), [ "+" | "-" ], digit, { digit } ] ;
string         = '"', { double-char | escape }, '"'
               | "'", { single-char | escape }, "'" ;
escape         = "\", ( '"' | "'" | "\" | "n" | "r" | "t"
                         | "u", hex, hex, hex, hex ) ;
comment        = "#", { comment-char } ;
letter-or-underscore = "A" .. "Z" | "a" .. "z" | "_" ;
digit          = "0" .. "9" ;
nonzero-digit  = "1" .. "9" ;
hex            = digit | "a" .. "f" | "A" .. "F" ;
(* double-char/single-char: Unicode scalar except matching quote, backslash,
   U+0000..001F and U+007F. comment-char: scalar except CR/LF.
   Reserved identifiers: sdui, ref, true, false, null, setHandle.
   Numbers must fit a finite IEEE-754 binary64 value; version is exact '0.1'.
   Profile checks reject mixing content with child boxes.
   No trailing commas. Empty boxes parse but fail validation. *)
