(* SDUI 0.3. EBNF: {repeat}, [optional], quoted terminals.
   Whitespace/comments are permitted between tokens; EOF is mandatory.
   Local profile restrictions, numeric types and resource limits: docs/profile-0.3.md. *)
document       = "sdui", "0.3", ";", { module-ref }, definition,
                 { definition }, { connection }, EOF ;
module-ref     = "ref", ":", identifier, string, ";" ;
definition     = identifier, "=", component, ";" ;
component      = [ identifier, "=" ], primary, [ "*", identifier ], [ formatting ] ;
primary        = frame | group | string | call-primary | identifier ;
call-primary   = widget-call, [ "[", [ rows ], "]" ] ;
(* Bodies required and permitted only for tabs/page/split/menu/menuGroup/dialog.
   command/item/separator are leaves. M2 command references and context/open
   targets are strings, resolved strictly for the selected expanded entry. *)
frame          = "[", [ rows ], "]" ;
group          = "<", [ rows ], ">" ;
rows           = row, { ";", row }, [ ";" ] ;
row            = component, { ",", component } ;
widget-call    = identifier, "(", [ arguments ], ")" ;
arguments      = argument, { ",", argument } ;
argument       = [ identifier, "=" ], value ;
value          = literal | member-ref ;
member-ref     = identifier, ".", identifier, ".", "@", identifier ;
connection     = identifier, ".", identifier, ".", "setHandle", "(",
                 identifier, ".", identifier, { ".", identifier }, ")", ";" ;
formatting     = "{", [ layout-rule, { ",", layout-rule } ], "}" ;
layout-rule    = property-name, "=", layout-value | number, ":", number | arrow ;
layout-value   = literal | identifier | number, "fr"
               | "(", number, { ",", number }, ")" ;
arrow          = "^<" | "<^" | "-^" | "^-" | ">^" | "^>"
               | "<-" | "-<" | "--" | "->" | ">-"
               | "v<" | "<v" | "-v" | "v-" | ">v" | "v>"
               | "<->" | "^|v" | ">-<" | ">|<" ;
property-name  = identifier, { "-", identifier } ;
literal        = string | number | "true" | "false" | "null" ;
identifier     = letter-or-underscore, { letter-or-underscore | digit } ;
number         = [ "-" ], ( "0" | nonzero-digit, { digit } ),
                 [ ".", digit, { digit } ],
                 [ ( "e" | "E" ), [ "+" | "-" ], digit, { digit } ] ;
string         = '"""', { raw-char }, '"""'
               | '"', { double-char | escape }, '"'
               | "'", { single-char | escape }, "'" ;
escape         = "\", ( '"' | "'" | "\" | "n" | "r" | "t"
                         | "u", hex, hex, hex, hex ) ;
comment        = "#", { comment-char } ;
letter-or-underscore = "A" .. "Z" | "a" .. "z" | "_" ;
digit          = "0" .. "9" ;
nonzero-digit  = "1" .. "9" ;
hex            = digit | "a" .. "f" | "A" .. "F" ;
(* String tokens use longest opening delimiter. Raw strings end at the next
   triple double quote, no escapes/interpolation/dedent. raw-char: Unicode scalar
   except controls (TAB/CR/LF permitted) and DEL; delimiter cannot occur inside.
   double-char/single-char exclude matching quote, backslash, U+0000..001F, DEL.
   comment-char excludes CR/LF. Escaped NUL/surrogates are rejected.
   Keywords sdui/ref/true/false/null/setHandle are reserved identifiers.
   Numbers must fit finite binary64; profile spelling is exactly '0.3'.
   Layout arrow whitespace is insignificant; hyphenated property names are
   single lexical tokens, with no whitespace inside the name.
   Parser accepts unknown arrow spellings for syntax-only diagnostics; local
   validation restricts them to this grammar. Empty containers are valid.
   In frames header/body/footer assignments are regions. In groups they are names.
   No trailing commas or empty rows; a final semicolon inside a container is valid.
   Frame variant is box/b only. Widget group elements cannot resolve to frames. *)

(* Profile 0.3 additionally validates tree/list calls: required nonblank string
   label (positional first or named), optional symbolic callback. Callbacks
   require named widgets. No provider/data literals or new callback syntax. *)

(* WCI3-M1 leaves: checkbox(label, value?:boolean, readOnly?:boolean, callback?),
   slider(label,min,max,step,value,readOnly?,callback?),
   number(label,min,max,step,value,readOnly?,placeholder?:string,callback?),
   select(label,value?:string,required?:boolean,readOnly?:boolean,callback?).
   Only label is positional; each following argument is named. min/max/step/value
   in slider/number must be numeric tokens: parser preserves their exact spelling
   as number-lexeme Literals; quoted strings reject. Other numeric literals keep
   their existing representation. Scalar controls accept no body. No source
   options/provider/validator/onChange expressions. *)

(* WCI3-M2 input remains a leaf: input(text, value?:string, multiline?:boolean,
   readOnly?:boolean, placeholder?:string, required?:boolean, callback?). Only
   text is positional. New argument presence (even false/empty) opts into extended
   input behavior; omission preserves legacy input. Booleans default false;
   omitted placeholder uses text. Defaults are not inserted into AST/instances.
   The 0.2 input schema remains text/value/callback only. No new literal kind. *)

(* WCI4 preview leaves: svg(source, label?:string, description:string,
   fallback:string) opts in by description/fallback presence; both then required.
   Explicit source must be a declared module.object.@resource reference.
   markdown(text, description:string, fallback:string) requires all three strings.
   Only source/text is positional. Description is nonblank UTF-8 <=4096 bytes;
   Markdown text <=32768 bytes; fallback exactly "label" or "reject".
   Markdown call source AST remains widget/Arguments; normalized Kind=markdown,
   Widget empty, Text=text argument, Arguments retained. Bare Markdown strings
   and old svg(source,label?) retain their existing representations/behavior. *)
